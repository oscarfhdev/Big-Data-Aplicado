CORE-SITE.XML_fs.defaultFS=hdfs://namenode:9000
CORE-SITE.XML_io.file.buffer.size=131072

# --- CONFIGURACIÓN DE INTEGRIDAD Y REPLICACIÓN EN HDFS (hdfs-site.xml) ---
HDFS-SITE.XML_dfs.replication=2
HDFS-SITE.XML_dfs.blocksize=134217728

# Rutas de almacenamiento persistente dentro de los contenedores
HDFS-SITE.XML_dfs.namenode.name.dir=file:///opt/hadoop/hadoop_data/hdfs/namenode
HDFS-SITE.XML_dfs.datanode.data.dir=file:///opt/hadoop/hadoop_data/hdfs/datanode

# --- CONFIGURACIÓN DEL SECONDARY NAMENODE (CHECKPOINTING) ---
HDFS-SITE.XML_dfs.namenode.checkpoint.dir=file:///opt/hadoop/hadoop_data/hdfs/secondary_namenode
HDFS-SITE.XML_dfs.namenode.secondary.http-address=0.0.0.0:9868

# Habilitar WebHDFS y desactivar permisos estrictos para laboratorio educativo
HDFS-SITE.XML_dfs.webhdfs.enabled=true
HDFS-SITE.XML_dfs.permissions.enabled=false

# --- LÍMITES DE MEMORIA HEAP DE LA JVM (JAVA_OPTS) ---
HADOOP_NAMENODE_OPTS=-Xmx512m -Xms256m
HADOOP_SECONDARYNAMENODE_OPTS=-Xmx384m -Xms128m
HADOOP_DATANODE_OPTS=-Xmx384m -Xms128m